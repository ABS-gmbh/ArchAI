CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
MODEL_DIR=./models
ANALYTICS_DB_PATH=./analytics.db
ANALYTICS_USERNAME=
ANALYTICS_PASSWORD=
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
MAX_POOL_WORKERS=3
# Root log level (DEBUG, INFO, WARNING, ERROR, CRITICAL) and line format (text or json).
LOG_LEVEL=INFO
LOG_FORMAT=text
# The SAIA / Chat AI key. The backend reads the first of these that is set:
# CHAT_AI_API_KEY, SAIA_API_KEY, ARCHAI_CHAT_AI_API_KEY, ARCHAI_SAIA_API_KEY.
# Set one and leave the others empty.
CHAT_AI_API_KEY=
CHAT_AI_BASE_URL=https://chat-ai.academiccloud.de/v1
# Seconds the chat client waits for an answer (a streamed answer: for each chunk). > 0.
CHAT_AI_TIMEOUT_SECONDS=180
SAIA_API_KEY=
ARCHAI_SAIA_API_KEY=
SAIA_BASE_URL=https://chat-ai.academiccloud.de/v1
SAIA_TIMEOUT_SECONDS=120
SAIA_MODELS_CACHE_TTL_SECONDS=300
SAIA_LABEL_ANALYSIS_MODEL=qwen3-vl-30b-a3b-instruct
CHAT_RAG_MODEL=qwen3-30b-a3b-instruct-2507
TRANSLATION_MODEL=llama-3.3-70b-instruct
LABEL_VISUAL_MODEL=qwen3-vl-30b-a3b-instruct
LABEL_VISUAL_FALLBACK_MODEL=internvl3.5-30b-a3b
SAIA_OCR_MODELS=qwen3-vl-30b-a3b-instruct,internvl3.5-30b-a3b,mistral-large-3-675b-instruct-2512,gemma-3-27b-it
# Backward-compatible aliases:
SAIA_OCR_MODEL_PREFERENCES=
SAIA_OCR_MODEL_PREFS=qwen3-vl-30b-a3b-instruct,internvl3.5-30b-a3b,mistral-large-3-675b-instruct-2512,gemma-3-27b-it
SAIA_OCR_TEMPERATURE=0
SAIA_OCR_MAX_TOKENS=8192
ARCHAI_CHAT_AI_MODEL=qwen3-30b-a3b-instruct-2507
RAG_AUTO_INDEX=True
RAG_COLLECTION_NAME=archai_chunks
RAG_ENTITY_COLLECTION_NAME=archai_entities
RAG_ENTITY_TOP_K=4
# Retrieval for chat. Defaults are measured (see the comments in app/config.py); change with a benchmark.
# Passages retrieved per chat question.
# RAG_TOP_K=8
# Lines per indexed passage, and lines shared by neighbouring passages; 1 and 0 restore one passage per line.
# RAG_CHUNK_WINDOW_LINES=6
# RAG_CHUNK_OVERLAP_LINES=2
# Fuse the embedding ranking with character 4-gram BM25; false is embeddings only.
# RAG_LEXICAL_FUSION=true
# BM25's weight in that fusion (the embeddings' is 1), and the weight used instead with ChromaDB's default model.
# RAG_LEXICAL_WEIGHT=1.0
# RAG_LEXICAL_WEIGHT_LOCAL=2.0
# Search scopes with more passages than this skip BM25 (its index is built per query).
# RAG_LEXICAL_MAX_CHUNKS=5000
GEONAMES_BASE_URL=https://secure.geonames.org
# Your own GeoNames account (free); empty disables GeoNames. Not "demo": it is over quota.
GEONAMES_USERNAME=
GEONAMES_TIMEOUT_SECONDS=10
PALEOGRAPHY_VERIFICATION_ENABLED=True
PALEOGRAPHY_VERIFICATION_MODEL=qwen3-235b-a22b
PALEOGRAPHY_VERIFICATION_TEMPERATURE=0
PALEOGRAPHY_VERIFICATION_MAX_TOKENS=900
PALEOGRAPHY_VERIFICATION_TIMEOUT_SECONDS=60
OCR_CROP_UPSCALE=2
OCR_MAX_PIXELS_PER_TILE=160000000
OCR_MAX_LONG_EDGE=12000
OCR_IMAGE_SIZE_RETRY_LIMIT=2
OCR_IMAGE_RETRY_SHRINK=0.82
# Tiles of one page sent to the vision model at once; 1 reads them one after another.
# OCR_TILE_CONCURRENCY=2
# segmented (layout + Kraken line recognition, GLM-OCR as fallback) or glmocr
FULL_PAGE_OCR_ENGINE=segmented
# true lets a text-quality score override the backend plan order (see app/config.py)
OCR_BACKEND_ELECTION=false
# Recogniser used when a request names none: auto (the planner chooses), kraken, glmocr, saia, calamari.
# OCR_BACKEND_DEFAULT=auto
# false keeps a versal initial apart from its word as Kraken read it ("C aldꝰ"; see app/config.py)
OCR_JOIN_DETACHED_INITIALS=true
RAG_EMBEDDING_MODEL=multilingual-e5-large-instruct
GLMOCR_OLLAMA_HOST=http://localhost:11434
GLMOCR_OLLAMA_MODEL=glm-ocr:latest
GLMOCR_OLLAMA_TIMEOUT_SECONDS=300
GLMOCR_OLLAMA_TEMPERATURE=0
GLMOCR_OLLAMA_RETRIES_PER_VARIANT=2
GLMOCR_MAX_PAYLOAD_BYTES=2000000
# GPU index (CUDA_VISIBLE_DEVICES) for GLM-OCR run in-process, not through Ollama.
# GLMOCR_DEVICE=0

# ---- Operations ----
# Bearer token for every route except /api/health; at least 24 characters.
# Empty leaves the API open, which is only safe when it is reachable from
# localhost alone. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# API_TOKEN=
# Data locations. Unset, each lives inside this directory: the pipeline database
# at app/archai.sqlite, the vector store at .data/chroma, the authority cache at
# app/.data/wikidata_cache.sqlite, the OCR evidence log at
# data/evidence/ocr_evidence.jsonl. Leave a line commented to keep the default:
# an empty value is a path too.
# ARCHAI_DB_PATH=/var/lib/archai/archai.sqlite
# CHROMA_PERSIST_DIR=/var/lib/archai/chroma
# ARCHAI_WIKIDATA_CACHE=/var/lib/archai/wikidata_cache.sqlite
# OCR_EVIDENCE_PATH=/var/lib/archai/ocr_evidence.jsonl
# Layout task uploads and outputs (default .tasks here); kept TASK_TTL_MINUTES, no backup needed.
# TASK_BASE_DIR=/var/lib/archai/tasks
# Upload limits: one upload, and the bytes a batch ZIP may expand to.
MAX_UPLOAD_MEGABYTES=1024
MAX_EXTRACTED_MEGABYTES=4096
# Every other request body (JSON, with a page image as base64): 48 MB fits an
# A4 page at 600 dpi saved as PNG.
MAX_JSON_MEGABYTES=48
# Minutes a layout task's files under .tasks/ are kept before the sweep removes them.
TASK_TTL_MINUTES=60
# Minutes an analytics login token stays valid.
JWT_EXPIRY_MINUTES=60
# Failed analytics logins allowed within the window, per client address and per
# user name from any address, then 429 (docs/deployment.md: what a lockout means).
# ANALYTICS_LOGIN_MAX_FAILURES=5
# ANALYTICS_LOGIN_MAX_FAILURES_PER_USERNAME=10
# ANALYTICS_LOGIN_WINDOW_SECONDS=900
# Runs a client reserves (POST /ocr/runs) to follow its own OCR request: seconds a
# reservation stays usable, and how many may wait unused before the route answers 429.
# OCR_RUN_RESERVATION_TTL_SECONDS=3600
# OCR_RUN_RESERVATION_MAX_LIVE=100
# Kraken recognition device (cpu, cuda, mps) and model directory.
KRAKEN_DEVICE=cpu
KRAKEN_MODELS_DIR=weights/kraken_models
# Layout inference runs in a worker pool, except on macOS where it runs in the
# request process. 1 forces in-process everywhere; 0 forces the pool on macOS too.
# ARCHAI_DISABLE_PROCESS_POOL=1
# Canned OCR answers for three test images. Never enable in production.
ENABLE_TEST_OCR_FIXTURES=false
# 1 exposes the /api/rag/debug endpoints.
ARCHAI_DEBUG_RAG=0
# /docs, /redoc and /openapi.json. Unset: on without API_TOKEN, off with it.
# true serves them, without the token, even when API_TOKEN is set; false never.
# ENABLE_API_DOCS=
# Scheduled retention of pipeline runs, off by default (0). With a number of
# days, runs older than that are deleted, at most RUN_RETENTION_MAX_PER_SWEEP per
# 15-minute sweep, keeping each page's newest run, benchmarked, annotated and
# showcase runs. Preview first: python scripts/prune_runs.py --older-than-days N
# RUN_RETENTION_DAYS=0
# RUN_RETENTION_MAX_PER_SWEEP=50
