# Root-level defaults for the ArchAI OCR CLI.
# Relative paths resolve from the directory containing config.example.yaml.
# Every variable here is optional; it overrides the YAML config when set.

ARCHAI_OCR_LAYOUT_YOLO=weights/layout_yolo.pt
ARCHAI_OCR_KRAKEN_RECOGNITION=weights/kraken_recognition.mlmodel
ARCHAI_OCR_KRAKEN_SEGMENTATION=weights/kraken_segmentation.mlmodel
ARCHAI_OCR_OUTPUT_DIR=outputs

# Layout behaviour
ARCHAI_OCR_MAIN_TEXT_CLASS=MainZone
ARCHAI_OCR_READING_ORDER=column
ARCHAI_OCR_CONFIDENCE_THRESHOLD=0.25

# Legacy names below are still honoured as aliases for the four above.
# ARCHAI_LAYOUT_YOLO_WEIGHTS=
# ARCHAI_KRAKEN_REC_WEIGHTS=
# ARCHAI_KRAKEN_SEG_WEIGHTS=
# ARCHAI_OUTPUT_DIR=
